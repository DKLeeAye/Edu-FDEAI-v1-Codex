# EduFDE local environment example

ENVIRONMENT=local
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
JWT_SECRET_KEY=dev-only-change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Gateway
# Default provider is SiliconFlow. Fill the API key and model before real AI calls.
AI_PROVIDER=siliconflow
AI_TIMEOUT_SECONDS=30
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Pro/zai-org/GLM-5.1
SILICONFLOW_CUSTOMER_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_REASONING_MODEL=Pro/zai-org/GLM-5.1

# PostgreSQL
POSTGRES_DB=edufde
POSTGRES_USER=edufde
POSTGRES_PASSWORD=edufde
DATABASE_URL=postgresql+psycopg://edufde:edufde@localhost:5432/edufde

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=edufde_minio
MINIO_ROOT_PASSWORD=edufde_minio_password
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=edufde-local
S3_ACCESS_KEY_ID=edufde_minio
S3_SECRET_ACCESS_KEY=edufde_minio_password
S3_REGION=us-east-1
